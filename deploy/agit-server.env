# Environment for agit-server.service. Install as /etc/agit/agit-server.env
# with mode 0640, owner root:agit (it may contain the bearer token).
#
# systemd EnvironmentFile syntax: KEY=value, no shell expansion, no quotes
# needed unless the value has leading/trailing whitespace.

# Where repositories are stored. Must match StateDirectory in the unit.
AGIT_DATA_DIR=/var/lib/agit

# Listen address. Keep it on localhost behind a TLS-terminating reverse proxy
# (deploy/Caddyfile, deploy/nginx.conf); use 0.0.0.0:7878 only on a private network.
AGIT_LISTEN=127.0.0.1:7878

# Bearer token required on every API request, including /api/v1/health.
# Generate one with:  openssl rand -hex 32
# Leave the line commented out (not empty) to run without authentication.
#AGIT_SERVER_TOKEN=replace-with-a-long-random-secret

# Serve the web UI from the same process. Unpack agit-web-<version>.tar.gz
# (from the GitHub release) or your own `web/dist` here.
#AGIT_WEB_DIR=/opt/agit/web

# Log level and filters (tracing-subscriber EnvFilter syntax).
# `tower_http=debug` logs every request.
RUST_LOG=info,tower_http=info

# Durability: refs (default, fsync ref updates and logs), all (fsync every
# object write), none (never fsync; throwaway servers only).
#AGIT_FSYNC=refs

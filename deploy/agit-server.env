# Environment for agit-server.service. Install as /etc/agit/agit-server.env
# with mode 0640, owner root:agit (it may contain the bearer token).
#
# systemd EnvironmentFile syntax: KEY=value, no shell expansion, no quotes
# needed unless the value has leading/trailing whitespace.

# Where repositories are stored. Must match StateDirectory in the unit.
AGIT_DATA_DIR=/var/lib/agit

# Listen address. Keep it on localhost behind a TLS-terminating reverse proxy
# (deploy/Caddyfile, deploy/nginx.conf); use 0.0.0.0:7878 only on a private network.
AGIT_LISTEN=127.0.0.1:7878

# Who may administer the server: SSH public keys (ssh-ed25519 lines, or a
# file with one key per line), comma-separated. People sign in with
# `agit auth login`; the admin then authorizes others with `agit auth key add`.
#AGIT_ADMIN_KEYS=/etc/agit/admin_keys

# Optional root bearer token with full access (for automation, or instead of
# admin keys). Generate one with:  openssl rand -hex 32
# Leave the line commented out (not empty) to not configure one.
#AGIT_SERVER_TOKEN=replace-with-a-long-random-secret

# Without admin keys and without a token the server is OPEN (every request
# acts as root) and refuses to start on a non-loopback address unless
# AGIT_ALLOW_OPEN=1 is set. Do not set it on a reachable interface.
#AGIT_ALLOW_OPEN=1

# Largest object upload request in MiB (default 1024). Pushes go in batches of
# about 8 MiB; a single file larger than that is sent alone, so keep this above
# the largest file in your repositories.
#AGIT_MAX_UPLOAD_MB=4096

# Serve the web UI from the same process. Unpack agit-web-<version>.tar.gz
# (from the GitHub release) or your own `web/dist` here.
#AGIT_WEB_DIR=/opt/agit/web

# Log level and filters (tracing-subscriber EnvFilter syntax).
# `tower_http=debug` logs every request.
RUST_LOG=info,tower_http=info

# Durability: refs (default; fsync(2) of the ref journal, like git), full
# (also flush the drive cache: power-loss safe on macOS, slower per commit),
# all (flush every object write), none (never fsync; throwaway servers only).
#AGIT_FSYNC=refs
